{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "DO_NOT_TRACK=1 OPENUI_TELEMETRY_DISABLED=1 npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cosmic-enhanced-jawfish.eur-1.aiven.app/api/:path*"
    }
  ]
}
