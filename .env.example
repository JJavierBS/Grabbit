# Copy to .env (scripts/setup.sh does it) and fill in. Never commit .env.
# One line per variable, with a short comment on what it is for.
CALA_API_KEY=    # Cala API key, from console.cala.ai/api-keys
CONTEXT_DEV_API_KEY=    # Context.dev key (ctxt_secret_...), from context.dev/dashboard/api-keys; server side only
GEMINI_API_KEY=    # Gemini API key (Google DeepMind); server side only
GEMINI_MODEL=gemini-3.5-flash    # Gemini model id (decisions.md); current list at ai.google.dev/gemini-api/docs/models
GEMINI_TIMEOUT_S=30    # seconds per Gemini call before giving up (retries 429 and 5xx up to 3 times)
GEMINI_THOUGHTS=0    # 1 shows Gemini's own reasoning summaries in the live walk, labelled as such
WALK_STEP_MIN_S=0    # demo pacing: hold each real Cala step on screen at least this long (0.6 for the projector); never adds steps
CALA_MODE=live    # live: call Cala and cache; replay: answer only from the cache (offline demo)
CALA_MAX_CONCURRENCY=1    # Cala requests in flight for the whole process; 4 at once tripped the 429
CALA_MIN_INTERVAL_MS=250    # minimum gap between Cala request starts; cached reads never wait
LLM_MODE=gemini    # gemini: real model; fake: scripted answers (tests, offline)
DEMO_MODE=1    # 1 enables /api/demo/simulate-event; 0 in production
DATABASE_PATH=data/grabbit.db    # SQLite file with profile, snapshots, reports and Cala cache
# Deploy only (scripts/server-init.sh); never uploaded to the server.
DEPLOY_HOST=    # EC2 public IP or DNS name
SSH_KEY=    # path to the AWS .pem for that host
DEPLOY_CALA_MODE=replay    # CALA_MODE written to the server .env on first upload
# Server .env only: a domain name pointed at the host turns on HTTPS in the edge proxy.
SITE_ADDRESS=
VALKEN_URL= #Aiven Valkey URI (rediss://…); empty = SQLite only
